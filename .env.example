# Quickno Environment Configuration
# Copy this file to .env and fill in your values

# ── AI API Endpoints ──────────────────────────────────────────────────────────
# The primary endpoint for the free Pollinations AI proxy
POLLINATIONS_API_URL=https://text.pollinations.ai/

# ── Application Defaults ──────────────────────────────────────────────────────
# Default search provider if none is specified
DEFAULT_SEARCH_ENGINE=https://www.google.com/search?q=

# ── Development Settings ──────────────────────────────────────────────────────
# Set to 'true' to enable verbose logging for debugging
DEBUG_MODE=false
