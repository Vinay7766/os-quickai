{
  "productName": "Quickno",
  "version": "1.0.2",
  "identifier": "com.quickno.app",
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "en-US",
        "upgradeCode": "B0A84D55-7B38-4E5C-8D9A-AD45F367A811"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "nsis/installer.nsh"
      }
    }
  },
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "label": "overlay",
        "title": "Quickno",
        "width": 480,
        "height": 52,
        "minWidth": 300,
        "minHeight": 50,
        "center": true,
        "decorations": false,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "transparent": true,
        "hiddenTitle": true,
        "visible": false,
        "resizable": true,
        "shadow": false
      },
      {
        "label": "settings",
        "title": "Quickno",
        "width": 780,
        "height": 620,
        "minWidth": 520,
        "minHeight": 450,
        "visible": false,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}
